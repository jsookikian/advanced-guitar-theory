{
  "name": "dominant-pentatonics-lesson",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive fretboard lesson: dominant pentatonic = C9 without root = Eø = Gm6",
  "scripts": {
    "build": "esbuild main.tsx --bundle --minify --outfile=dist/app.js --jsx=automatic --alias:grok/canvas=./grok-canvas-shim.ts --define:process.env.NODE_ENV='\"production\"'",
    "watch": "esbuild main.tsx --bundle --outfile=dist/app.js --jsx=automatic --alias:grok/canvas=./grok-canvas-shim.ts --define:process.env.NODE_ENV='\"development\"' --watch",
    "serve": "esbuild main.tsx --bundle --outdir=dist --entry-names=app --jsx=automatic --alias:grok/canvas=./grok-canvas-shim.ts --define:process.env.NODE_ENV='\"development\"' --servedir=. --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0"
  }
}
